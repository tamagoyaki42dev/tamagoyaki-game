# Godot 4+ specific ignores
.godot/
/android/

# ビルド出力（書き出したexe/Web版。配布はitch/Steamへ、リポジトリには載せない）
/build/
/build_web/

# Secrets - NEVER commit these
.env
*.env
secrets.py

# Python
__pycache__/
*.pyc
.venv/
venv/

# 自動生成スクショ（SNS投稿後に削除されるが念のため）
tools/screenshot.png
tools/screenshot_trigger

# Claude Code ローカル設定（個人パスが入るため除外）
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# アセット zip（展開済みのため不要）
*.zip

# Quaternius アセットパック（大容量のため除外・各自ダウンロード）
assets/quaternius-rpg-items/
assets/quaternius-ultimate-characters/

# KayKit 追加無料パック（探索用ストック・大容量のため除外・各自ダウンロード）
# ※統合済みの characters/ animations/ は追跡対象。ここは packs/ の未整理ストックのみ除外
assets/kaykit/packs/

# ライセンス制約アセット（Booth等・再配布禁止）＝公開リポジトリに載せない
# 原本(FelizHair/)も改変派生(Mage_hair_final.glb等)も felisshoppe のメッシュそのもの＝単体配布に当たるため除外。
# 詳細・利用条件は CREDITS.md。ビルドは作業ツリーから焼き込むためゲーム本体には含まれる（.pck）。ローカル原本は各自バックアップすること。
assets/kaykit/parts/

# VRoid顔移植の実験（撤退済み・未使用）。.vrm は VRoid標準アセットを含み公開再配布は避けたいため除外。フォルダごと削除予定。
assets/vroidTest/

# Blender 自動バックアップ（次回保存で再生成される）
*.blend1

# VRoid由来の作業用blend（ライセンス制約＝再配布回避＋60MB級で大容量）。
# ビルドはローカル作業ツリーから焼く（assets/kaykit/_source/build_furou_hair.py）。
# 新しいVRoid髪の作業blendもここに追記していく。
assets/kaykit/characters/pink.blend

# Kenney アセットパック（大容量のため除外・各自ダウンロード）
assets/kenney-dungeon-kit/
assets/kenney-hexagon-kit/
assets/kenney-mini-characters/
assets/kenney-nature-kit/
assets/kenney-platformer-kit/
assets/kenney-survival-kit/

# KayKit生zip展開（キュレーション元。統合済みファイルは各追跡フォルダへコピー済みのため不要・大容量）
assets/kaykit/_source/

# Quaternius候補プレビュー一式（基本不採用・保管判断だがリポジトリには載せない・100MB級）
assets/quaternius_preview/

# 開発ツールの生成プレビュー画像（実行のたびに再生成される・スクラッチ扱い）
tools/_*.png
tools/_*.png.import
